{
  "name": "blockchain-rme-break-glass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "chain:init": "node infrastructure/chain.mjs init",
    "chain:start": "node infrastructure/chain.mjs start",
    "chain:status": "node infrastructure/chain.mjs status",
    "chain:health": "node infrastructure/chain.mjs health",
    "chain:stop": "node infrastructure/chain.mjs stop",
    "chain:restart": "node infrastructure/chain.mjs restart",
    "chain:logs": "node infrastructure/chain.mjs logs",
    "chain:accounts": "node infrastructure/chain.mjs accounts",
    "chain:approve": "node infrastructure/chain.mjs approve",
    "chain:fund": "node infrastructure/chain.mjs fund",
    "chain:reset": "node infrastructure/chain.mjs reset",
    "chain:test": "node --test infrastructure/test/*.test.mjs",
    "chain:verify": "node infrastructure/verify.mjs",
    "gateway:start": "node gateway/main.ts",
    "gateway:typecheck": "node smart-contract/node_modules/typescript/bin/tsc -p gateway/tsconfig.json",
    "gateway:test:besu": "node --test gateway/normal-consent.test.ts",
    "contracts:compile": "npm --prefix smart-contract run compile",
    "contracts:test": "npm --prefix smart-contract test",
    "contracts:deploy": "npm --prefix smart-contract run deploy:besu --"
  },
  "dependencies": { "viem": "2.57.16" }
}
