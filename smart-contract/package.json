{
  "name": "blockchain-rme-break-glass-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.ts",
    "export:abi": "node scripts/export-abi.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && npm run typecheck && npm run test:contracts && npm run test:deployment",
    "test:contracts": "hardhat test solidity",
    "test:deployment": "node --test test/deployment.test.ts",
    "deploy:besu": "npm run compile && node scripts/deploy-besu.ts",
    "deployer:address": "node scripts/deployer-address.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "hardhat": "3.21.1",
    "typescript": "5.9.3",
    "viem": "2.57.16"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
